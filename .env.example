# Firebase (só o login com Google; os dados da conta ficam no Neon) — Console do
# Firebase → Configurações do projeto → Seus apps → app web. Sem elas a conta some
# do app. `api/sync` também lê VITE_FIREBASE_PROJECT_ID para conferir o token.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Login no app Android: Authentication → Sign-in method → Google → "Web client ID".
VITE_GOOGLE_WEB_CLIENT_ID=

# Salas online (só no servidor; nunca com prefixo VITE_) — ver CLAUDE.md
DATABASE_URL=
REDIS_URL=
CRON_SECRET=
